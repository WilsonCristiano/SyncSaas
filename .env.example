# --- Vercel Postgres (auto-injetadas ao conectar o Storage ao projeto) ---
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Webhook Apify: URL https://SEU-APP.vercel.app/api/webhook-apify?secret=<WEBHOOK_SECRET>
#     Evento: ACTOR.RUN.SUCCEEDED
WEBHOOK_SECRET=
ADMIN_PASSWORD=
APIFY_TOKEN=

# --- Disparo do worker (GitHub Actions repository_dispatch) ---
# URL:   https://api.github.com/repos/<OWNER>/<REPO>/dispatches
# Token: fine-grained PAT com permissão "Contents: read and write"
WORKER_TRIGGER_URL=
WORKER_TRIGGER_TOKEN=
